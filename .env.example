# ─────────────────────────────────────────────────────────────────────────────
#  ComfyUI Mobile Studio — 설정 파일 예시
#  `.env` 로 복사해서 채워 넣으세요 (처음 실행하면 start-demo.bat 이 자동으로 만듭니다).
#  `.env` 는 git 에 올라가지 않습니다: 실제 값은 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────────────────────

# ── 웹앱 ─────────────────────────────────────────────────────────────────────
# 127.0.0.1 그대로 두세요: Cloudflare Tunnel 은 이 PC 안에서 연결하므로 다른 접근이 필요 없습니다.
APP_HOST=127.0.0.1
APP_PORT=8080

# Cloudflare Tunnel 로 공개할 도메인 (Origin/CSRF 확인과 쿠키 Secure 설정에 씁니다).
# 이 PC 에서만 쓸 때는 비워 두세요.
DOMAIN=
# 선택: 공개 주소가 https://$DOMAIN 과 다를 때만 전체 주소를 적습니다
PUBLIC_ORIGIN=
# Cloudflare Tunnel 뒤에서 실행할 때 true (횟수 제한에 실제 접속자 IP 인 CF-Connecting-IP 사용)
TRUST_PROXY=false

# ── ComfyUI 백엔드 (인터넷에서 접속되면 안 됩니다) ──────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
# 비워 두면 COMFYUI_URL 에서 만듭니다 (ws://127.0.0.1:8188/ws)
COMFYUI_WS_URL=
COMFYUI_REQUEST_TIMEOUT_MS=15000

# ── 접속 제어 ────────────────────────────────────────────────────────────────
# 로그인 화면에서 입력할 비밀번호 (필수, 8자 이상).
# 만드는 법 예:  node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ACCESS_TOKEN=
# 세션 쿠키 서명용 비밀키. 길고 랜덤한 값을 넣으면 서버를 다시 켜도 로그인이 유지됩니다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
# 선택: 스크립트에서 "Authorization: Bearer <API_KEY>" 로 호출 허용 (비워 두면 꺼짐)
API_KEY=
# 로컬 개발 전용 (APP_HOST 가 127.0.0.1 일 때만): ACCESS_TOKEN 없이 실행
ALLOW_NO_AUTH=false

# ── 남용 방지 · 제한값 ───────────────────────────────────────────────────────
GENERATE_RATE_LIMIT_PER_MIN=6
LOGIN_RATE_LIMIT_PER_MIN=5
# 생성은 한 번에 1건. 그 뒤에 이만큼 더 기다릴 수 있고, 넘으면 HTTP 429 (바쁨)
MAX_PENDING_JOBS=2
JOB_IDLE_TIMEOUT_SEC=180
JOB_MAX_DURATION_SEC=900
MAX_PROMPT_LENGTH=1500
MAX_STEPS=40
MAX_BATCH_SIZE=2
MAX_PIXELS=2359296
MAX_LORAS=3
MAX_UPLOAD_MB=8

# ── 모델 · 워크플로우 · 콘텐츠 ───────────────────────────────────────────────
WORKFLOW_FILE=workflows/txt2img.api.json
# 어떤 모델을 화면에 보여 줄지 정합니다.
# folder    = 모델 폴더 안의 전용 하위 폴더(MODEL_FOLDER)에 넣은 모델만 공개 (기본, 권장)
#             예: <모델 폴더>/checkpoints/portfolio/ , <모델 폴더>/loras/portfolio/
#             MODELS_CONFIG 에 따로 적은 모델도 함께 공개
# allowlist = MODELS_CONFIG 에 적은 모델만 공개
# all       = ComfyUI 에 설치된 모든 체크포인트/LoRA 공개 (공개 데모에는 쓰지 마세요)
MODEL_LIST_MODE=folder
MODEL_FOLDER=portfolio
# 표시 이름 · 기본 모델 · LoRA 강도 (folder 모드에서는 선택 사항)
MODELS_CONFIG=config/models.json
STYLE_PRESETS_FILE=config/style-presets.json
PROMPT_TAGS_FILE=config/prompt-tags.json
# 거절할 단어 목록 (선택, config/blocked-terms.example.txt 참고)
BLOCKED_TERMS_FILE=config/blocked-terms.txt
# 서버가 모든 네거티브 프롬프트 뒤에 항상 붙이는 문구 (선택)
SAFETY_NEGATIVE=
# ComfyUI 출력 하위 폴더 (output/<OUTPUT_SUBFOLDER>/...)
OUTPUT_SUBFOLDER=portfolio-demo
GALLERY_LIMIT=48
DATA_DIR=data

# 선택 기능 — 포즈/참조 이미지: ComfyUI 에 보이는 ControlNet 파일 이름 그대로
# (예: SDXL 용 OpenPose ControlNet). 비워 두면 기능이 숨겨집니다.
CONTROLNET_MODEL=
# "openpose" 로 두면 사진에서 포즈 추출 가능 (comfyui_controlnet_aux 커스텀 노드 필요)
CONTROLNET_PREPROCESSOR=none

LOG_LEVEL=info

# ── Windows 실행 파일 (start-demo.bat) ──────────────────────────────────────
# ComfyUI 포터블 폴더 (python_embeded\ 와 ComfyUI\ 가 들어 있는 폴더).
# 비워 두면 start-demo.bat 이 드라이브에서 찾아보고, 찾으면 여기에 저장합니다.
COMFYUI_DIR=
# ComfyUI 추가 실행 옵션. --listen 은 넣지 마세요 (ComfyUI 는 이 PC 안에서만 접속돼야 합니다).
COMFYUI_EXTRA_ARGS=--preview-method auto

# ── Cloudflare Tunnel (`npm run tunnel` · start-demo.bat 에서만 사용) ───────
# Cloudflare Zero Trust → Networks → Tunnels → 내 터널 → Install 화면의 토큰
CLOUDFLARE_TUNNEL_TOKEN=
# cloudflared 가 PATH 에 없으면 실행 파일 경로
CLOUDFLARED_PATH=
